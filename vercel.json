{
  "outputDirectory": "public",
  "routes": [
    { "src": "/api/auth", "dest": "/api/auth.js" },
    { "src": "/api/places", "dest": "/api/places.js" },
    { "src": "/api/crm", "dest": "/api/crm.js" },
    { "src": "/api/mapskey", "dest": "/api/mapskey.js" },
    { "src": "/api/owner", "dest": "/api/owner.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
